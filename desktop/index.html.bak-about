<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>No[co]de Vibe Designer</title>
  <meta name="theme-color" content="#101214">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <link rel="manifest" href="./manifest.webmanifest">
  <link rel="apple-touch-icon" href="../mobile/icons/icon-192.png">
  <link rel="stylesheet" href="./styles.css">
</head>
<body data-theme="stage" data-workspace="bureau">
<div id="companionDetect" class="companion-detect hidden" role="dialog" aria-live="polite">
  <p id="companionDetectText">Companion détecté</p>
  <div class="companion-detect-actions">
    <button type="button" data-detect="open-studio">Éditer ce Companion</button>
    <button type="button" data-detect="sync">Sync</button>
    <button type="button" data-detect="monitor">Use as Monitor</button>
    <button type="button" data-detect="controller">Use as Controller</button>
    <button type="button" data-detect="ignore" class="ghost">Ignore</button>
  </div>
</div>
<div id="demoModeBanner" class="demo-mode-banner hidden" role="status">
  <div><b>EXEMPLE · WOW INTERACTIF</b><span>Déplace la souris dans le Preview</span></div>
  <button id="demoExitBtn" type="button">EXIT · QUITTER L’EXEMPLE</button>
</div>
<dialog id="companionEditorDialog" class="companion-editor-dialog">
  <div class="companion-editor-shell">
    <header><div><b>Éditer ce Companion</b><span id="companionEditorStatus">Layout Local First · synchronisation live via l’hôte No-de</span></div><button id="companionEditorClose" type="button" class="btn">Fermer</button></header>
    <iframe id="companionEditorFrame" title="Companion Studio"></iframe>
  </div>
</dialog>
<dialog id="shaderDialog" class="shader-dialog">
  <div class="shader-shell">
    <header><div><b>Shader Lab</b><span>GLSL fragment · Ctrl/Cmd+Entrée applique</span></div><button id="shaderClose" type="button" class="btn">Fermer</button></header>
    <textarea id="shaderSource" spellcheck="false" aria-label="Code GLSL"></textarea>
    <div class="shader-actions"><button id="shaderApply" type="button" class="btn primary">Compiler + appliquer</button><button id="shaderReset" type="button" class="btn">Réinitialiser</button><span id="shaderStatus" role="status"></span></div>
  </div>
</dialog>
<div id="app">
  <header class="topbar">
    <div class="brand"><div class="brandmark" title="No[co]de Vibe Designer">◒</div><div><b>No<span class="co">[co]</span>de Vibe Designer</b><span>VIBE · PATCH · STAGE</span></div></div>
    <span class="badge">v3.2.0</span>
    <div class="pnp-wrap"><button id="pnpBtn" class="btn pnp-chip" type="button" title="Plug & Play · détection automatique">P&P · AUTO</button><div id="pnpMenu" class="pnp-menu hidden"><button type="button" id="pnpRefresh">↻ Détecter à nouveau</button><button type="button" id="pnpMidi">MIDI · connecter</button><button type="button" id="pnpSerial">USB / Arduino / ESP · connecter</button><small id="pnpSummary">Les périphériques déjà autorisés se reconnectent automatiquement.</small></div></div>
    <div class="spacer"></div>
    <div class="themes workspace-modes"><a class="active" href="./index.html">Designer</a><a href="../show/index.html">Show</a></div>
    <button id="controlsBtn" class="btn">Controls</button>
    <button id="preferencesBtn" class="btn">Préférences</button>
    <button id="saveProject" class="btn">Enregistrer</button>
    <button id="loadProject" class="btn">Ouvrir</button>
    <input id="projectFile" type="file" accept=".cvd.json,application/json" hidden>
    <button id="outputBtn" class="btn primary">OUTPUT ↗</button>
  </header>

  <section class="workspace">
    <aside class="panel library resizable-x">
      <div class="panel-head">Library <span class="sub">＋ production · ○ expérimental</span></div>
      <div class="search"><input id="search" placeholder="Rechercher…"></div>
      <label class="library-mode"><input id="showExperimental" type="checkbox"> Afficher les expérimentaux</label>
      <div id="libraryList" class="panel-body libscroll"></div>
    </aside>

    <main class="center">
      <div class="upper">
        <section class="panel patch resizable-both" id="patchPanel">
          <div class="panel-head">Patch Canvas <span class="sub" title="Molette : zoom · Clic milieu ou Alt + glisser : déplacer le canevas · Clic : sélectionner">Patch actuel</span>
            <div class="tools">
              <button type="button" id="zoomOut" class="iconbtn" title="Zoom −">−</button>
              <button type="button" id="zoomReset" class="iconbtn canvas-zoom" title="Centrer la vue">100 %</button>
              <button type="button" id="zoomIn" class="iconbtn" title="Zoom +">+</button>
              <button type="button" id="wrapBtn" class="iconbtn" title="Regrouper la sélection dans un bloc">Bloc</button>
              <button type="button" class="iconbtn collapse" title="Réduire">−</button>
            </div>
          </div>
          <div id="graphPath" class="graph-path"></div>
          <div id="patchSpace" class="panel-body patch-space"></div>
        </section>

        <section class="panel preview floatable" id="previewPanel" data-float-id="preview" data-dock-axis="float" data-min-w="300">
          <div class="panel-head">Preview <span class="sub"><span class="live">● Aperçu</span> · clic : placer un point</span><div class="tools"><button type="button" class="iconbtn float-dock" title="Ancrer" hidden>Ancrer</button><button type="button" class="iconbtn collapse" title="Réduire">−</button></div></div>
          <div class="panel-body preview-body">
            <canvas id="previewCanvas" width="1280" height="720"></canvas>
            <div id="previewOverlay" class="preview-overlay"></div>
            <div class="preview-foot"><span id="previewInfo">1280×720 · 60 fps</span><span class="spacer"></span><button id="magicFxBtn" class="smallbtn">✦ Magic FX</button><button id="clearPoints" class="smallbtn">Effacer les points</button></div>
          </div>
          <div class="float-resize" title="Redimensionner"></div>
        </section>
      </div>

      <section class="panel vibe floatable" id="vibePanel" data-float-id="vibe" data-min-w="320">
        <div class="panel-head">Vibe <span class="sub">Entrée : envoyer · Maj+Entrée : nouvelle ligne</span><div class="tools"><button type="button" class="iconbtn float-dock" title="Ancrer" hidden>Ancrer</button><button type="button" class="iconbtn collapse" title="Réduire">−</button></div></div>
        <div class="panel-body vibe-body">
          <div class="vibe-reference">
            <label for="vibeImageFile" class="smallbtn vibe-image-pick">＋ Image</label>
            <input id="vibeImageFile" type="file" accept="image/*" hidden>
            <img id="vibeImageThumb" class="vibe-image-thumb" alt="" hidden>
            <select id="vibeImageTarget" aria-label="Cible de l’image">
              <option value="auto">Auto</option>
              <option value="p5">Dessin</option>
              <option value="glsl">Lumière</option>
              <option value="particles">Particules</option>
              <option value="sdf">Formes</option>
            </select>
            <button id="vibeImageClear" type="button" class="smallbtn" hidden>Retirer</button>
            <span id="vibeImageInfo" class="sub">Image optionnelle</span>
          </div>
          <div class="vibe-scroll">
            <textarea id="vibeText" placeholder="Ex. : Fais réagir le rideau de fils à la souris">Fais réagir le rideau de fils à la souris et ajoute des ondes lumineuses.</textarea>
            <div id="vibePreview" class="vibe-preview hidden"></div>
          </div>
          <div class="vibe-actions">
            <button id="applyVibe" class="generate" type="button">Envoyer</button>
          </div>
        </div>
        <div class="float-resize" title="Redimensionner"></div>
      </section>

      <section class="panel timeline floatable" id="timelinePanel" data-float-id="timeline" data-min-w="420">
        <div class="panel-head">Timeline <span class="sub">glisser les clips · ajuster la durée</span><div class="tools"><button type="button" class="iconbtn float-dock" title="Ancrer" hidden>Ancrer</button><button type="button" class="iconbtn collapse" title="Réduire">−</button></div></div>
        <div class="panel-body timeline-shell">
          <div class="timeline-toolbar">
            <button id="play" class="smallbtn">▶</button>
            <button id="stop" class="smallbtn">■</button>
            <span id="timecode">00:00.0</span>
            <div class="spacer"></div>
            <button id="addCue" class="smallbtn">+ Cue</button>
            <button id="addEffect" class="smallbtn">+ Effet</button>
            <button id="cueGo" class="smallbtn">GO</button>
            <button id="cuePrev" class="smallbtn">◀ Cue</button>
            <button id="cueNext" class="smallbtn">Cue ▶</button>
            <button id="cuePanic" class="smallbtn danger">PANIC</button>
          </div>
          <div class="timeline-routing-wrap">
            <div id="timelineBody" class="timeline-body">
              <div class="timeline-inner">
                <div id="playhead" class="playhead"></div>
                <div class="track-labels">
                  <div class="track-label">Vidéo</div><div class="track-label">Effets</div><div class="track-label">Shader</div>
                  <div class="track-label">Ombre</div><div class="track-label">Cues</div><div class="track-label">Liaisons</div>
                </div>
                <div id="tracks" class="tracks">
                  <div class="track" data-track="0"></div><div class="track" data-track="1"></div><div class="track" data-track="2"></div>
                  <div class="track" data-track="3"></div><div class="track" data-track="4"></div><div class="track" data-track="5"></div>
                </div>
              </div>
            </div>
            <div class="route-strip">
              <div class="route-title">SORTIE</div>
              <button class="route-btn" data-track-route="0">Principal</button>
              <button class="route-btn" data-track-route="1">Principal</button>
              <button class="route-btn" data-track-route="2">Principal</button>
              <button class="route-btn" data-track-route="3">Principal</button>
              <button class="route-btn" data-track-route="4">Principal</button>
              <button class="route-btn" data-track-route="5">Principal</button>
            </div>
          </div>
        </div>
        <div class="float-resize" title="Redimensionner"></div>
      </section>
    </main>

    <aside class="panel inspector resizable-x">
      <div class="panel-head">Inspecteur <span id="inspectorType" class="sub">Aucun</span><div class="tools"><button type="button" class="iconbtn collapse" title="Réduire">−</button></div></div>
      <div id="inspectorBody" class="panel-body inspector-body">
        <p>Sélectionne un node.</p>
      </div>
    </aside>
  </section>

  <section class="terminal resizable-y">
    <div class="term-tabs"><span>Console</span><span class="live">● READY</span><span>PATCH</span><span>OUTPUT</span><span>OSC</span><span>MIDI</span><span>DMX</span></div>
    <div id="termLog" class="term-log"></div>
    <div class="term-input"><input id="termCmd" placeholder="demo · midi connect · bridge connect ws://… · output"><button id="termSend">↵</button></div>
  </section>
</div>

<div id="preferencesModal" class="preferences-modal hidden">
  <div class="preferences-card wide">
    <div class="preferences-head"><b>Préférences</b><button id="preferencesClose" type="button">×</button></div>
    <div class="preferences-tabs">
      <button type="button" data-pref-tab="general" class="active">Général</button>
      <button type="button" data-pref-tab="appearance">Interface</button>
      <button type="button" data-pref-tab="canvas">Patch Canvas</button>
      <button type="button" data-pref-tab="ai">IA / Vibe</button>
      <button type="button" data-pref-tab="io">Moteurs / I/O</button>
      <button type="button" data-pref-tab="backup">Sauvegardes</button>
      <button type="button" data-pref-tab="manual">Manuel</button>
      <button type="button" data-pref-tab="about">Version</button>
    </div>
    <div class="preferences-body">
      <div data-pref-panel="general">
        <p class="hint">Langue d’interface : français. Démarrage : restaurer l’autosave si disponible.</p>
        <label>Restaurer l’autosave au lancement <input id="prefRestoreAutosave" type="checkbox" checked></label>
        <label>Plug & Play · reconnecter automatiquement les périphériques déjà autorisés <input id="prefPlugAndPlay" type="checkbox" checked></label>
        <label>Charger l’exemple WOW interactif si projet vide <input id="prefLoadDemo" type="checkbox" checked></label>
        <label>Mode technique <input id="prefTechnicalMode" type="checkbox"></label>
        <div id="backendReport" class="hint"></div>
      </div>
      <div data-pref-panel="appearance" class="hidden">
        <label>Couleur dominante <input id="accentColor" type="color" value="#d7b86a"></label>
        <label>Couleur secondaire <input id="secondaryColor" type="color" value="#8fa79d"></label>
        <label>Dégradé principal <select id="gradientMode"><option value="subtle">Discret</option><option value="off">Désactivé</option><option value="strong">Présent</option></select></label>
        <label>Intensité <input id="gradientIntensity" type="range" min="0" max="100" value="35"></label>
        <div class="preferences-actions"><button id="appearanceReset" class="smallbtn" type="button">Thème No[co]de Vibe Designer</button></div>
      </div>
      <div data-pref-panel="canvas" class="hidden">
        <p class="hint">Zoom : molette. Déplacer le canevas : clic milieu ou Alt + glisser. Sélectionner : clic. Centrer : bouton 100 %.</p>
        <label>Zoom par défaut <input id="prefDefaultZoom" type="range" min="50" max="150" value="100"></label>
      </div>
      <div data-pref-panel="ai" class="hidden">
        <p class="hint"><b>IA locale prioritaire</b> : No-de utilise d’abord Ollama sur cette machine pour générer des opérations de patch JSON. Si elle est indisponible, repli automatique sur le moteur local déterministe.</p>
        <label>Activer l’IA générative locale <input id="aiLocalEnabled" type="checkbox" checked></label>
        <label class="stack">Serveur local / LAN<input id="aiLocalBase" type="url" value="http://127.0.0.1:11434" placeholder="http://192.168.1.20:11434"></label>
        <div class="local-agents">
          <div class="local-agents-head">
            <div><b>Agents locaux</b><span id="aiAgentsSummary" class="hint">Non détectés</span></div>
            <button id="aiAgentsScan" class="smallbtn" type="button">↻ Détecter / actualiser</button>
          </div>
          <div id="aiAgentsList" class="local-agents-list">
            <p class="hint">Détecte automatiquement les modèles Ollama disponibles, comme CX hub, puis choisis leur rôle.</p>
          </div>
        </div>
        <details class="ai-legacy">
          <summary>Réglage manuel / compatibilité</summary>
          <label class="stack">Modèle principal<input id="aiLocalModel" type="text" value="qwen2.5-coder:7b"></label>
          <label class="stack">Modèle léger<input id="aiLocalSecondaryModel" type="text" value="gemma3:1b"></label>
          <label>Duo local parallèle <input id="aiLocalParallel" type="checkbox" checked></label>
          <div class="preferences-actions">
            <button id="aiInstallQwen" class="smallbtn" type="button">Installer Qwen</button>
            <button id="aiInstallGemma" class="smallbtn" type="button">Installer Gemma</button>
            <button id="aiLocalProbe" class="smallbtn" type="button">Tester l’IA locale</button>
            <span id="aiLocalStatus" class="hint">Non testée</span>
          </div>
        </details>
        <hr>
        <p class="hint">Cloud optionnel : utilisé seulement si l’IA locale échoue et qu’un endpoint distant est activé.</p>
        <p class="hint bad">Grok / xAI est exclu et sera refusé.</p>
        <label>Autoriser le secours IA distant <input id="aiEnabled" type="checkbox"></label>
        <label class="stack">Endpoint (OpenAI-compatible)<input id="aiEndpoint" type="url" placeholder="https://api.openai.com/v1/chat/completions"></label>
        <label class="stack">Clé API<input id="aiKey" type="password" placeholder="sk-… (stockée localement)"></label>
        <label class="stack">Modèle distant<input id="aiModel" type="text" value="gpt-4o-mini"></label>
        <div class="preferences-actions"><button id="aiSave" class="smallbtn" type="button">Enregistrer IA</button></div>
      </div>
      <div data-pref-panel="io" class="hidden">
        <p class="hint">MIDI / Serial / OSC passent par le graphe lorsque les nodes sont connectés.</p>
        <ul class="pref-list">
          <li><b>MIDI</b> — console <code>midi connect</code> puis node MIDI Hub → sorties CC/gate. Essai matériel : à vérifier.</li>
          <li><b>Serial</b> — <code>serial connect</code> / <code>serial reconnect</code> / <code>serial send …</code>. Reconnexion auto sur ports déjà autorisés.</li>
          <li><b>OSC</b> — node OSC + <code>bridge connect ws://…</code>. Sans bridge : erreur visible, pas de faux succès.</li>
          <li><b>Caméra</b> — permission uniquement après action « Activer la caméra » dans l’inspecteur.</li>
          <li><b>Whale / Blob / Threshold / Ghost / Mirror / Shadow</b> — moteurs locaux exécutables dans le patch.</li>
          <li><b>Audio</b> — moteur local actif (Audio Lab, filtre, delay, FFT, Organic Audio). <b>NDI Out</b> utilise un relais natif et reste PLATFORM-LIMITED sans hôte compatible. Syphon/Spout ne sont pas encore exposés comme moteurs actifs.</li>
        </ul>
        <div class="preferences-actions" style="margin-top:12px;display:flex;flex-wrap:wrap;gap:8px">
          <button type="button" id="runDiagnosticBtn" class="smallbtn">Diagnostic spectacle</button>
          <button type="button" id="copyDiagnosticBtn" class="smallbtn">Copier diagnostic</button>
          <button type="button" id="showHostCard" class="smallbtn">Carte hôte / QR</button>
          <button type="button" id="exportMaxBtn" class="smallbtn">Export Max</button>
          <button type="button" id="exportTdBtn" class="smallbtn">Export TD</button>
          <button type="button" id="exportPdBtn" class="smallbtn">Export Pure Data</button>
          <button type="button" id="exportMilluminBtn" class="smallbtn">Carte Millumin OSC</button>
        </div>
        <hr>
        <p class="hint"><b>Vibe Out</b> — transforme le patch courant en fichier de travail ouvrable dans un logiciel externe grâce à l’IA locale ou à ton endpoint externe.</p>
        <label class="stack">Cible
          <select id="vibeOutTarget">
            <option value="max">Max/MSP · JS à copier-coller</option>
            <option value="touchdesigner">TouchDesigner · Python à copier-coller</option>
            <option value="p5">p5.js · sketch</option>
            <option value="processing">Processing · .pde</option>
            <option value="puredata">Pure Data · .pd</option>
            <option value="maxpat">Max/MSP · fichier .maxpat</option>
          </select>
        </label>
        <label class="stack">IA
          <select id="vibeOutProvider">
            <option value="auto">Auto · local puis endpoint</option>
            <option value="local">Locale · Ollama</option>
            <option value="external">Endpoint externe configuré</option>
          </select>
        </label>
        <label class="stack">Consigne
          <textarea id="vibeOutInstruction" rows="4" placeholder="Ex. : recrée le patch en gardant les contrôles OSC et organise le réseau proprement."></textarea>
        </label>
        <div class="preferences-actions">
          <button type="button" id="vibeOutGenerate" class="smallbtn">Vibe Out → générer</button>
          <button type="button" id="vibeOutCopy" class="smallbtn" disabled>Copier le code</button>
          <button type="button" id="vibeOutDownload" class="smallbtn" disabled>Télécharger</button>
          <span id="vibeOutStatus" class="hint">Prêt</span>
        </div>
        <textarea id="vibeOutResult" rows="12" spellcheck="false" placeholder="Le code généré apparaîtra ici…"></textarea>
        <pre id="diagnosticOut" class="term-log" style="max-height:260px;margin-top:10px;display:none"></pre>
        <pre id="hostCardOut" class="term-log" style="max-height:160px;margin-top:10px;display:none"></pre>
      </div>
      <div data-pref-panel="backup" class="hidden">
        <p class="hint">Autosave navigateur (<code>cvd.autosave</code>) + export fichier <code>.cvd.json</code>.</p>
        <button type="button" id="clearAutosave" class="smallbtn danger">Effacer l’autosave locale</button>
      </div>
      <div data-pref-panel="manual" class="hidden">
        <iframe id="manualFrame" class="manual-frame" src="../docs/manual/index.html" title="Manuel No[co]de Vibe Designer"></iframe>
      </div>
      <div data-pref-panel="about" class="hidden">
        <p id="versionInfo">No[co]de Vibe Designer</p>
        <p class="hint"><b>PWA</b> — application web utilisable directement dans votre navigateur, sans installation obligatoire.</p>
        <p class="hint"><b>Mac</b> — application native Apple Silicon distribuée directement depuis le site lorsqu’un build est publié.</p>
        <p class="hint"><b>Companion</b> — sur téléphone, No-de peut devenir télécommande, caméra et capteur. Les fonctions Remote Camera restent marquées expérimentales tant que la recette terrain n’est pas validée.</p>
        <p class="hint">Schéma projet <code>cvd.graph</code> · même moteur de patch entre les variantes compatibles.</p>
        <p class="hint"><a class="copyright-link" href="https://github.com/cdriccarboni" target="_blank" rel="noopener noreferrer" aria-label="GitHub de Cédric Carboni"><span class="copyright-default">© 2026 Cédric Carboni</span><span class="copyright-hover">GitHub · Cédric Carboni ↗</span></a></p>
      </div>
    </div>
  </div>
</div>

<div id="magicFxModal" class="preferences-modal hidden">
  <div class="preferences-card magic-card">
    <div class="preferences-head"><b>Magic FX</b><button id="magicFxClose" type="button">×</button></div>
    <div class="magic-grid">
      <button type="button" data-magic-fx="ghost"><b>Ghost</b><small>traînée temporelle</small></button>
      <button type="button" data-magic-fx="threshold"><b>Threshold</b><small>silhouette instantanée</small></button>
      <button type="button" data-magic-fx="mirror"><b>Mirror</b><small>miroir</small></button>
      <button type="button" data-magic-fx="shadow"><b>Shadow</b><small>ombre miroir</small></button>
      <button type="button" data-magic-fx="bodyclone"><b>Body Clone</b><small>dédoublement simple</small></button>
      <button type="button" data-magic-fx="blob"><b>Blob</b><small>forme organique</small></button>
      <button type="button" data-magic-fx="blackhole"><b>Black Hole</b><small>visuel génératif</small></button>
      <button type="button" data-supernode="digital-curtain"><b>Digital Curtain · V3</b><small>SuperNode interactif</small></button>
      <button type="button" data-supernode="living-shadow"><b>Living Shadow · V3</b><small>SuperNode corps / ombre</small></button>
      <button type="button" data-supernode="feedback-dream"><b>Feedback Dream · V3</b><small>SuperNode feedback</small></button>
      <button type="button" data-supernode="particle-field"><b>Particle Field · V3</b><small>SuperNode particules</small></button>
      <button type="button" data-supernode="quick-map"><b>Quick Map · V3</b><small>mapping téléphone</small></button>
    </div>
    <p class="hint magic-hint">Sélectionne une source vidéo puis choisis un effet. Le résultat reste un vrai node dans PATCH.</p>
  </div>
</div>

<div id="controlsModal" class="preferences-modal hidden">
  <div class="preferences-card wide">
    <div class="preferences-head"><b>Control Surface · No-de Channels</b><button id="controlsClose" type="button">×</button></div>
    <div class="controls-toolbar"><span class="hint">Expose seulement les paramètres utiles à la régie. Les valeurs restent celles des nodes du patch.</span><button id="controlsRefresh" class="smallbtn" type="button">Actualiser</button></div>
    <div id="controlSurface" class="control-surface"></div>
  </div>
</div>

<div id="routeSheet" class="route-sheet hidden">
  <div class="route-sheet-head"><b id="routeSheetTitle">Routage piste</b><button id="routeSheetClose" type="button">×</button></div>
  <div class="route-section">
    <label>Mode</label>
    <div class="route-modes">
      <button type="button" data-route-mode="main">Principal</button>
      <button type="button" data-route-mode="only">Uniquement vers…</button>
      <button type="button" data-route-mode="copy">Copie vers…</button>
    </div>
  </div>
  <div class="route-section"><label>Destinations</label><div id="routeDestinations" class="route-dests"></div></div>
  <div class="route-hint">Les adaptateurs natifs (NDI, Syphon, Spout) sont préparés dans le modèle mais ne sont affichés comme actifs que lorsqu'un backend compatible est réellement disponible.</div>
</div>

  <script src="https://unpkg.com/peerjs@1.5.5/dist/peerjs.min.js"></script>
  <script type="module" src="./app.js"></script>
</body>
</html>
