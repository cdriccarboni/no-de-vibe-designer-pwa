{
  "name": "no-de-vibe-designer",
  "productName": "No-de Vibe Designer",
  "version": "3.3.1",
  "description": "No-de Vibe Designer \u2014 environnement de patch nodal pour le spectacle vivant",
  "author": "C\u00e9dric Carboni",
  "homepage": "https://github.com/cdriccarboni",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node tests/run.mjs",
    "test:pwa": "playwright test -c playwright.config.mjs",
    "build:pwa": "node scripts/build-pwa.mjs",
    "serve:pwa": "node scripts/serve-pwa.mjs",
    "android:sync": "node scripts/sync-android.mjs",
    "android:apk": "node scripts/build-android.mjs",
    "android:apk:release": "node scripts/build-android.mjs --release",
    "icons": "node scripts/make-icons.mjs",
    "remote:bridge": "node bridge/remote-server.mjs",
    "serve:companion": "node scripts/serve-companion.mjs",
    "check": "node tests/run.mjs && node tests/soakTest.mjs",
    "pack:mac": "electron-builder --mac dir --arm64",
    "dist:mac": "electron-builder --mac zip --arm64",
    "pack:linux": "electron-builder --linux zip --x64",
    "serve:web": "node scripts/serve-web.mjs",
    "release:check": "npm run audit:production && npm test && npm run check && npm run build:pwa",
    "android:aab": "node scripts/build-android.mjs --aab",
    "deploy:pwa": "node scripts/deploy-pwa.mjs",
    "audit:production": "node tests/run.mjs"
  },
  "build": {
    "appId": "fr.acousmatic.nodevibedesigner",
    "productName": "No-de Vibe Designer",
    "copyright": "Copyright \u00a9 2026 C\u00e9dric Carboni",
    "directories": {
      "output": "dist/electron",
      "buildResources": "packaging/mac"
    },
    "files": [
      "electron/**/*",
      "desktop/**/*",
      "shared/**/*",
      "src/**/*",
      "docs/**/*",
      "examples/**/*",
      "mobile/**/*",
      "studio/**/*",
      "companion/**/*",
      "bridge/**/*",
      "index.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "packaging/mac/VibeDesigner.icns",
        "to": "VibeDesigner.icns"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "packaging/mac/VibeDesigner.icns",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSCameraUsageDescription": "No-de Vibe Designer utilise la cam\u00e9ra pour les nodes vid\u00e9o, tracking et retours sc\u00e8ne.",
        "NSMicrophoneUsageDescription": "No-de Vibe Designer utilise le micro pour les nodes audio et communications temps r\u00e9el."
      }
    },
    "linux": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics",
      "artifactName": "No-de-Vibe-Designer-${version}-${arch}-linux.${ext}"
    },
    "asar": true,
    "backgroundColor": "#090d16"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}